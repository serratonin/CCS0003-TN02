#include <iostream>
#include <cmath>
#include <iomanip>

int main() {
    double x1, y1, x2, y2;

    std::cout << "Enter x1: ";
    std::cin >> x1;
    std::cout << "\n";

    std::cout << "Enter y1: ";
    std::cin >> y1;
    std::cout << "\n";

    std::cout << "Enter x2: ";
    std::cin >> x2;
    std::cout << "\n";

    std::cout << "Enter y2: ";
    std::cin >> y2;
    std::cout << "\n";

    double dx = x2 - x1;
    double dy = y2 - y1;
    double distance = std::sqrt(std::pow(dx, 2) + std::pow(dy, 2));
    int roundedDistance = static_cast<int>(std::round(distance));

    std::cout << std::fixed << std::setprecision(3);
    std::cout << "dx: " << dx << "\n";
    std::cout << "dy: " << dy << "\n";
    std::cout << "Straight-line distance: " << distance << "\n";
    std::cout << "Rounded whole-unit distance: " << roundedDistance << "\n";

    return 0;
}
